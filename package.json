{
  "name": "rfq-reset-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Interactive self-financing RFQ inventory control laboratory",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
